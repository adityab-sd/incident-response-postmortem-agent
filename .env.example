# Incident Response & Root Cause Post-Mortem Agent — Environment Configuration
# Copy this file to .env and fill in your credentials. Never commit .env!

# --- LLM Provider Credentials ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# --- Integrations (Slack & PagerDuty) ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_DEFAULT_CHANNEL=C01INCIDENTS
PAGERDUTY_API_KEY=u+your_pagerduty_api_key
PAGERDUTY_WEBHOOK_SECRET=your_pagerduty_webhook_secret

# --- Persistence & Runtime ---
INCIDENT_DB_PATH=./data/incidents.db
CONFIG_MODELS_PATH=./config/models.yaml
CONFIG_THRESHOLDS_PATH=./config/thresholds.yaml
LOG_LEVEL=INFO
USE_MOCK_LLM=auto
